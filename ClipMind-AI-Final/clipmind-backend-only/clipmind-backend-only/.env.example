# Rename this file to .env before running the backend

# Secret key used to sign JWT tokens. Change this to a long random string in production.
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL.
# SQLite (default, zero setup, good for local dev):
DATABASE_URL=sqlite:///./clipmind.db

# If your team decides to use PostgreSQL instead, comment the line above and use:
# DATABASE_URL=postgresql://username:password@localhost:5432/clipmind

# Folder where uploaded videos are stored
UPLOAD_DIR=uploads

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=200
